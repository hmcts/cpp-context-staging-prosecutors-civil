{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/staging/prosecutors/json/schemas/hearing-date-range-details.json",
  "type": "object",
  "properties": {
    "startDateRangeOfHearing": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/date",
      "description": "Start date of the hearing date range (YYYY-MM-DD)"
    },
    "endDateRangeOfHearing": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/date",
      "description": "End date of the hearing date range (YYYY-MM-DD)"
    },
    "courtHearingLocation": {
      "type": "string",
      "description": "The OUCODE of the courthouse (reference data)",
      "minLength": 1,
      "maxLength": 7
    },
    "timeOfHearing": {
      "type": "string",
      "description": "The actual start time of the hearing",
      "pattern": "^(2[0-3]|[01]?[0-9]):([0-5]?[0-9]):([0-5]?[0-9])$",
      "maxLength": 8
    }
  },
  "required": [
    "startDateRangeOfHearing",
    "endDateRangeOfHearing",
    "courtHearingLocation",
    "timeOfHearing"
  ]
}