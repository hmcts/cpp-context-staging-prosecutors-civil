{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/stagingprosecutorscivil/query/stagingprosecutorscivil.query.charge-prosecution",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "status": {
      "$ref": "http://cpp.moj.gov.uk/staging/prosecutors/json/schemas/definitions.json#/definitions/submissionStatus"
    },
    "type": {
      "$ref": "http://cpp.moj.gov.uk/staging/prosecutors/json/schemas/definitions.json#/definitions/submissionType"
    },
    "receivedAt": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/date-time"
    },
    "completedAt": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/date-time"
    },
    "materialWarnings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/problem.json"
      }
    },
    "materialErrors": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/problem.json"
      }
    },
    "caseErrors": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/case-problem.json"
      }
    },
    "defendantErrors": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/defendant-problem.json"
      }
    },
    "caseWarnings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/case-problem.json"
      }
    },
    "defendantWarnings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/defendant-problem.json"
      }
    }
  },
  "required": [
    "id",
    "status",
    "type",
    "receivedAt",
    "materialErrors",
    "materialWarnings",
    "caseErrors",
    "defendantErrors",
    "caseWarnings",
    "defendantWarnings"
  ]
}
